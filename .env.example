# Backend Server Port (automatically set by cloud deployment providers like Render, Railway, Fly.io)
PORT=8000

# CORS Allowed Origins (* for all or comma-separated list like https://naturetech.vercel.app)
ALLOWED_ORIGINS=*

# Geospatial OpenStreetMap Overpass API Configuration
OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SEC=15
NGO_SEARCH_RADIUS_KM=50.0

# Reforestation Economics Benchmarks
COST_PER_TREE_USD=2.50
TREES_PER_SQM=0.25

# Optional NASA FIRMS Key for Real-Time Wildfire Hotspots (Free from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
NASA_FIRMS_MAP_KEY=
